ARG RELION_RELEASE=5.0
ARG CUDA_VERSION=12.8.0

FROM ghcr.io/czimaginginstitute/relion:${RELION_RELEASE}-cuda${CUDA_VERSION} AS base

# explicit prefix: Apptainer overrides $HOME, breaking micromamba's default lookup
ENV MAMBA_ROOT_PREFIX=/home/relion/.local/share/mamba

SHELL ["/bin/bash", "-l", "-c"]
RUN micromamba create -n relion-zarr-sta python=3.11 -c conda-forge -y
SHELL ["micromamba", "run", "-n", "relion-zarr-sta", "/bin/bash", "-l", "-c"]

RUN pip install --no-cache-dir uv
RUN uv pip install --no-cache py2rely zarr-particle-tools
# keep conda license files, drop the package cache
RUN find "${MAMBA_ROOT_PREFIX}/pkgs" -path '*/info/licenses' -type d | while read -r d; do \
      mkdir -p /opt/licenses/conda-zarr-sta && cp -r "$d" "/opt/licenses/conda-zarr-sta/$(basename "$(dirname "$(dirname "$d")")")" || exit 1; \
    done \
 && test -n "$(ls -A /opt/licenses/conda-zarr-sta)" \
 && micromamba clean -afy
# setuid apptainer needs the env under /home/relion readable
RUN chmod 755 /home/relion
WORKDIR /work
RUN zarr-particle-pipeline --help
RUN py2rely --help
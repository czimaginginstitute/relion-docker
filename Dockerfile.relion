ARG CUDA_VERSION=12.8.0

# ---- build stage ----
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu22.04 AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG RELION_REF=ver5.0
# ver5.1: CMake list ("80-real;90-real"); ver5.0: single number; empty = RELION default
ARG CUDA_ARCH=""
ARG CTFFIND_VER=4.1.14
ARG CTFFIND_SHA256=380209a5283f343cccd6385b8ae425ae79a5f05e1c69eea5f28cae7871bff998
ENV CTFFIND_HOME=/opt/ctffind-${CTFFIND_VER}
ENV MAMBA_ROOT_PREFIX=/root/.local/share/mamba

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config \
    openmpi-bin libopenmpi-dev \
    libfftw3-dev libtiff-dev libpng-dev \
    ghostscript pbzip2 xz-utils zstd ca-certificates \
    libfltk1.3-dev libx11-dev libxft-dev libxext-dev libxinerama-dev libxrender-dev \
    wget curl \
 && rm -rf /var/lib/apt/lists/*

COPY extras/ctffind-${CTFFIND_VER}-linux64.tar.gz /tmp/ctffind.tgz
RUN echo "${CTFFIND_SHA256}  /tmp/ctffind.tgz" | sha256sum -c - \
 && mkdir -p "$CTFFIND_HOME" \
 && tar -xzf /tmp/ctffind.tgz -C "$CTFFIND_HOME" && rm -f /tmp/ctffind.tgz \
 && install -m 0755 "$CTFFIND_HOME"/bin/* /usr/local/bin/

ARG MICROMAMBA_VER=2.9.0-0
ARG MICROMAMBA_SHA256=366cd9cd8be14df1ab8ed50352a82111082a36686b2d389fdb79a92c3fafb3e3
ARG MAMBA_LICENSE_SHA256=41fd98a468e39d319911bd94f4e65d6ad6a7ea66559dd5aa4112f138ff9b629a
RUN curl -fsSL -o /usr/local/bin/micromamba \
      "https://github.com/mamba-org/micromamba-releases/releases/download/${MICROMAMBA_VER}/micromamba-linux-64" \
 && echo "${MICROMAMBA_SHA256}  /usr/local/bin/micromamba" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/micromamba \
 && mkdir -p /opt/licenses \
 && curl -fsSL -o /opt/licenses/MICROMAMBA-LICENSE \
      "https://raw.githubusercontent.com/mamba-org/mamba/${MICROMAMBA_VER%-*}/LICENSE" \
 && echo "${MAMBA_LICENSE_SHA256}  /opt/licenses/MICROMAMBA-LICENSE" | sha256sum -c -
SHELL ["/bin/bash", "-l", "-c"]

# pins the clone; busts the cache when upstream moves (empty = branch tip)
ARG RELION_SHA=""
WORKDIR /opt
RUN git clone https://github.com/3dem/relion.git --branch ${RELION_REF} --single-branch --depth 1 \
 && if [ -n "${RELION_SHA}" ]; then \
      git -C relion fetch --depth 1 origin "${RELION_SHA}" && git -C relion checkout --detach "${RELION_SHA}"; \
    fi
WORKDIR /opt/relion

# GPL corresponding-source record
RUN mkdir -p /opt/licenses \
 && cp /opt/relion/LICENSE /opt/licenses/RELION-LICENSE \
 && git -C /opt/relion rev-parse HEAD > /opt/licenses/RELION-SOURCE-COMMIT.txt

RUN micromamba create -f /opt/relion/environment.yml --yes && micromamba clean -a --yes

# runtime COPY needs these to exist
RUN mkdir -p build /usr/local/lib /usr/local/share
WORKDIR /opt/relion/build
# FindCondaPython needs `conda`; without this every relion_python_* wrapper has no interpreter
RUN cmake .. -DCMAKE_BUILD_TYPE=Release -DFETCH_WEIGHTS=OFF -DGUI=OFF -DCUDA_ARCH="${CUDA_ARCH}" \
    -DPYTHON_EXE_PATH="${MAMBA_ROOT_PREFIX}/envs/$(sed -n 's/^name: *//p' /opt/relion/environment.yml)/bin/python"
RUN make -j"$(nproc)" && make install
# upstream wrapper points at the build dir (5.1+)
RUN f=/usr/local/bin/relion_python_trace_amyloids; [ ! -e "$f" ] || sed -i 's|^relion_home=.*|relion_home="/usr/local"|' "$f"

# upstream pins setuptools 59.5.0 (HIGH CVEs); <81 keeps pkg_resources. The pkgs cache holds the
# old copy; keep its license files, drop the rest.
RUN micromamba run -n "$(sed -n 's/^name: *//p' /opt/relion/environment.yml)" \
    pip install --no-cache-dir "setuptools>=78.1.1,<81" \
 && find "${MAMBA_ROOT_PREFIX}/pkgs" -path '*/info/licenses' -type d | while read -r d; do \
      mkdir -p /opt/licenses/conda && cp -r "$d" "/opt/licenses/conda/$(basename "$(dirname "$(dirname "$d")")")" || exit 1; \
    done \
 && test -n "$(ls -A /opt/licenses/conda)" \
 && rm -rf "${MAMBA_ROOT_PREFIX}/pkgs"

# ---- runtime stage ----
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu22.04 AS runtime

ARG DEBIAN_FRONTEND=noninteractive
ARG CTFFIND_VER=4.1.14
ENV CTFFIND_HOME=/opt/ctffind-${CTFFIND_VER}
ENV PATH="/usr/local/bin:${PATH}"

# changes weekly in CI so the upgrade layer isn't cached forever
ARG APT_REFRESH=""
# GUI=OFF; glib/libGL let PyQt5 load headless (dynamight imports it)
RUN echo "apt refresh: ${APT_REFRESH}" && apt-get update && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends \
    openmpi-bin libfftw3-single3 libfftw3-double3 \
    libtiff5 libpng16-16 ghostscript libgomp1 ca-certificates \
    libglib2.0-0 libgl1 \
 && rm -rf /var/lib/apt/lists/*

# the conda env lives under /root (0700 in the base image)
RUN useradd -ms /bin/bash relion && chmod 711 /root

COPY --from=build --chown=relion:relion /usr/local/bin/ /usr/local/bin/
COPY --from=build --chown=relion:relion /usr/local/lib/ /usr/local/lib/
COPY --from=build --chown=relion:relion /usr/local/share/ /usr/local/share/
COPY --from=build --chown=relion:relion ${CTFFIND_HOME}/ ${CTFFIND_HOME}/
COPY --from=build --chown=relion:relion /root/.local/share/mamba /root/.local/share/mamba

COPY --from=build --chown=relion:relion /opt/licenses/ /opt/licenses/
COPY --chown=relion:relion THIRD_PARTY_LICENSES.md /opt/licenses/THIRD_PARTY_LICENSES.md

RUN ldd /usr/local/bin/relion_refine | grep -q "not found" \
    && { echo "ERROR: missing runtime libraries"; ldd /usr/local/bin/relion_refine | grep "not found"; exit 1; } \
    || relion_refine --version

USER relion
# empty torch_home: weights go to the user's ~/.cache/torch, not /root
RUN /root/.local/share/mamba/envs/relion-*/bin/python -c "import dynamight" \
 && relion_python_dynamight --help > /dev/null \
 && grep -q '^torch_home=""$' /usr/local/bin/relion_python_blush \
 && { [ ! -e /usr/local/bin/relion_python_trace_amyloids ] || relion_python_trace_amyloids --help > /dev/null; } \
 && test -s /opt/licenses/MICROMAMBA-LICENSE && test -n "$(ls -A /opt/licenses/conda)"
WORKDIR /work
